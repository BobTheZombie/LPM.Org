#!/bin/bash
# LPM build script for the LPM command-line package manager

NAME="lpm"
VERSION="1.0.1"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="Linux Package Manager with SAT solving, hooks, deltas, and lpmbuild support"
URL="https://github.com/BobTheZombie/LPM.Org"
LICENSE=("MIT")

# Build the current repository branch. Tagged releases can replace "main" with
# "${VERSION}" once matching GitHub tags are published.
SOURCE=(
    "https://github.com/BobTheZombie/LPM.Org/archive/refs/heads/main.tar.gz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "glibc"
    "lpm-filesystem"
    "openssl"
    "sqlite"
    "tar"
    "xz"
    "zstd"
)

BUILD_REQUIRES=(
    "binutils"
    "curl"
    "gcc"
    "git"
    "make"
    "patchelf"
    "python"
)

PROVIDES=(
    "lpm"
    "lpm-core"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=("python-pyside6")

BUILD_OPTIONS=(
    "@--stripping"
    "@--lto"
    "@--optimize=2"
)

_lpm_srcdir() {
    local candidate

    for candidate in \
        "$SRCROOT/LPM.Org-main" \
        "$SRCROOT/LPM.Org-${VERSION}" \
        "$SRCROOT/${NAME}-${VERSION}"
    do
        if [ -f "$candidate/Makefile" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    candidate="$(
        find "$SRCROOT" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -name 'LPM.Org-*' \
            -exec test -f '{}/Makefile' ';' \
            -print \
            -quit
    )"

    test -n "$candidate"
    printf '%s\n' "$candidate"
}

prepare() {
    set -euxo pipefail

    SRCDIR="$(_lpm_srcdir)"

    test -f "$SRCDIR/Makefile"
    test -f "$SRCDIR/src/lpm/__main__.py"
    test -f "$SRCDIR/etc/lpm/lpm.conf"

    command -v git
    command -v patchelf
    python3 -m pip --version

    rm -rf \
        "$SRCDIR/build/nuitka" \
        "$SRCDIR/build/nuitka-src"
}

build() {
    set -euxo pipefail

    SRCDIR="$(_lpm_srcdir)"
    cd "$SRCDIR"

    if [ -n "${SOURCE_DATE_EPOCH:-}" ]; then
        BUILD_DATE="$(
            date -u \
                -d "@${SOURCE_DATE_EPOCH}" \
                '+%Y-%m-%dT%H:%M:%SZ'
        )"
    else
        BUILD_DATE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi

    # The lpm target deliberately excludes lpm-ui and therefore does not
    # require PySide6 in bootstrap or server environments.
    make \
        VERSION="${VERSION}" \
        BUILD_DATE="${BUILD_DATE}" \
        NUITKA_REPO="https://github.com/Nuitka/Nuitka.git" \
        NUITKA_REF="develop" \
        lpm \
        build/build-info.json
}

check() {
    set -euxo pipefail

    SRCDIR="$(_lpm_srcdir)"

    "$SRCDIR/build/nuitka/lpm.bin" --help >/dev/null
    "$SRCDIR/build/nuitka/lpm.bin" buildpkg --help >/dev/null
}

staging() {
    set -euxo pipefail

    SRCDIR="$(_lpm_srcdir)"
    cd "$SRCDIR"

    make \
        VERSION="${VERSION}" \
        PREFIX=/usr \
        DESTDIR="$pkgdir" \
        install-lpm

    test -x "$pkgdir/usr/bin/lpm"
    test ! -e "$pkgdir/usr/bin/lpm-ui"
    test -f "$pkgdir/etc/lpm/lpm.conf"
    test -f "$pkgdir/usr/lib/sysusers.d/lpm.conf"
    test -f "$pkgdir/usr/lib/tmpfiles.d/lpm.conf"
    test -f "$pkgdir/usr/share/lpm/build-info.json"
    test -f "$pkgdir/usr/share/licenses/lpm/LICENSE"

    "$pkgdir/usr/bin/lpm" --help >/dev/null
}
