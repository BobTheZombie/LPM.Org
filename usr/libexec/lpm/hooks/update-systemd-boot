#!/usr/bin/env python3
"""Maintain LPM-owned BLS entries and update an existing systemd-boot install."""
from __future__ import annotations
import argparse
import configparser
import fcntl
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

MARKER = '# Generated by LPM systemd-boot; do not edit.'


def atomic_copy(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix='.lpm-', dir=destination.parent)
    try:
        with os.fdopen(descriptor, 'wb') as out, source.open('rb') as incoming:
            shutil.copyfileobj(incoming, out, 1 << 20)
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, destination)
    finally:
        Path(temporary).unlink(missing_ok=True)


def atomic_text(text, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix='.lpm-', dir=destination.parent)
    try:
        with os.fdopen(descriptor, 'w') as out:
            out.write(text)
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, destination)
    finally:
        Path(temporary).unlink(missing_ok=True)


def inside(root, relative):
    path = root / relative
    if not path.resolve().is_relative_to(root.resolve()):
        raise RuntimeError(f'Path escapes boot filesystem: {path}')
    return path


def prepare_entries(root, esp, config):
    cmdline = (root/'etc/kernel/cmdline').read_text().strip()
    if not cmdline or '\n' in cmdline or '\r' in cmdline or 'CHANGE-ME' in cmdline:
        raise RuntimeError('/etc/kernel/cmdline must contain one configured kernel command line')
    entries = []
    for kernel in sorted((root/'usr/lib/modules').glob('*/vmlinuz')):
        version = kernel.parent.name
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._+-]*', version):
            raise RuntimeError(f'Invalid kernel version: {version}')
        initrd_name = config.get('initrd', '/boot/initrd-{version}.img').replace('{version}', version)
        if not initrd_name.startswith('/'):
            raise RuntimeError('initrd configuration must be an absolute path')
        initrd = root / initrd_name.lstrip('/')
        if not initrd.is_file():
            raise RuntimeError(f'Missing initramfs {initrd}; generate it before updating boot entries')
        files = [(kernel, f'lpm/{version}/vmlinuz')]
        lines = [MARKER, f'title LPM Linux ({version})', f'version {version}',
                 f'linux /lpm/{version}/vmlinuz']
        for index, name in enumerate(config.get('microcode', '').split()):
            if not name.startswith('/'):
                raise RuntimeError('microcode paths must be absolute')
            source = root/name.lstrip('/')
            if not source.is_file():
                raise RuntimeError(f'Missing microcode image: {source}')
            target = f'lpm/{version}/microcode-{index}.img'
            files.append((source, target))
            lines.append(f'initrd /{target}')
        files.append((initrd, f'lpm/{version}/initrd.img'))
        lines.extend([f'initrd /lpm/{version}/initrd.img', f'options {cmdline}', ''])
        entry = f'loader/entries/lpm-{version}.conf'
        for _, target in files:
            inside(esp, target)
        destination = inside(esp, entry)
        if destination.exists() and not destination.read_text().startswith(MARKER+'\n'):
            raise RuntimeError(f'Refusing to replace an unmanaged boot entry: {destination}')
        entries.append((files, destination, '\n'.join(lines)))
    return entries


def ensure_esp_mounted(root, esp):
    """Mount the configured ESP through the target's fstab when necessary."""
    if not esp.is_absolute() or esp.is_symlink():
        raise RuntimeError(f'Invalid ESP mountpoint: {esp}')
    if os.path.ismount(esp):
        return
    if not esp.is_dir():
        raise RuntimeError(f'ESP mountpoint does not exist: {esp}')
    fstab = root/'etc/fstab'
    if not fstab.is_file():
        raise RuntimeError(f'ESP is unmounted and /etc/fstab is missing: {esp}')
    entries = []
    for line in fstab.read_text(encoding='utf-8').splitlines():
        line = line.split('#', 1)[0].strip()
        fields = line.split()
        if len(fields) >= 3 and fields[1] == str(esp):
            entries.append(fields)
    if not entries:
        raise RuntimeError(f'ESP is unmounted and has no /etc/fstab entry: {esp}')
    if len(entries) != 1 or entries[0][2] not in ('vfat', 'auto'):
        raise RuntimeError(f'ESP fstab entry must specify vfat or auto: {esp}')
    mount = shutil.which('mount')
    if mount is None:
        raise RuntimeError('mount utility not found; cannot mount ESP')
    print(f'[lpm:systemd-boot] Mounting configured ESP from /etc/fstab: {esp}')
    try:
        subprocess.run([mount, str(esp)], check=True)
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(f'Failed mounting configured ESP: {esp}') from exc
    if not os.path.ismount(esp):
        raise RuntimeError(f'ESP mount command succeeded but mountpoint remains unmounted: {esp}')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--install', action='store_true', help='explicitly install systemd-boot without modifying firmware variables')
    args = parser.parse_args(argv)
    root = Path(os.environ.get('LPM_ROOT', '/')).resolve()
    if root != Path('/'):
        if args.install:
            raise RuntimeError('Run --install inside the target chroot, with its ESP mounted')
        print('[lpm:systemd-boot] Skipping alternate-root transaction')
        return 0
    path = root/'etc/lpm/systemd-boot.conf'
    if not path.exists():
        if args.install:
            raise RuntimeError(f'Missing configuration: {path}')
        return 0
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.read(path)
    if not cfg.getboolean('boot', 'enabled', fallback=False):
        return 0
    config = cfg['boot']
    esp = Path(config.get('esp', '/boot/efi'))
    ensure_esp_mounted(root, esp)
    bootctl = shutil.which('bootctl')
    if not bootctl:
        raise RuntimeError('bootctl is missing; install systemd with bootloader support')
    return update(root, esp, config, bootctl, args.install)


def update(root, esp, config, bootctl, install=False):
    command = [bootctl, '--esp-path='+str(esp), '--no-variables']
    lockfile = root/'var/lib/lpm/systemd-boot.lock'
    lockfile.parent.mkdir(parents=True, exist_ok=True)
    with lockfile.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not install and subprocess.run(command+['is-installed'], check=False).returncode:
            print('[lpm:systemd-boot] Not installed on configured ESP; skipping')
            return 0
        entries = prepare_entries(root, esp, config)
        if not entries:
            raise RuntimeError('No kernels found under /usr/lib/modules/*/vmlinuz')
        loader = inside(esp, 'loader/loader.conf')
        if not loader.exists():
            atomic_text('default lpm-*\ntimeout 5\neditor no\n', loader)
        for files, destination, text in entries:
            for source, relative in files:
                atomic_copy(source, inside(esp, relative))
            atomic_text(text, destination)
        subprocess.run(command+['install' if install else 'update'], check=True)
        print(f'[lpm:systemd-boot] Updated {len(entries)} kernel entries on {esp}')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, configparser.Error) as exc:
        print(f'[lpm:systemd-boot] ERROR: {exc}', file=sys.stderr)
        raise SystemExit(1)
